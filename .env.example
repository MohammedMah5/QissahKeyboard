# Firebase Configuration — copy to .env / .env.production and fill in your
# own project's web app config (Firebase Console → Project settings → Your apps).
# NOTE: Firebase *web* config values are public-by-design (they ship in the client
# bundle). Protect the project with Firestore rules + API key referrer restrictions
# in Google Cloud Console instead of relying on secrecy.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# App Configuration
VITE_APP_ENV=development